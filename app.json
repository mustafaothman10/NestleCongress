{
  "expo": {
    "name": "Nestle Congress",
    "slug": "NestleCon",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/nestle-icon.png",
    "scheme": "nestlecongress",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/nestle-icon.png",
        "backgroundImage": "./assets/images/nestle-icon.png",
        "monochromeImage": "./assets/images/nestle-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.othmanmostafa373.NestleCon"
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-sqlite",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "b76cd08c-7c00-43df-a94e-eb04d8709d85"
      }
    }
  }
}
